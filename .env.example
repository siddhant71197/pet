# Copy to .env.local (or .env) and fill in.
# SQLite file path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"
REPLICATE_API_TOKEN=
# Model on Replicate: google/gemini-3.5-flash (default) or anthropic/claude-sonnet-5
REPLICATE_MODEL=google/gemini-3.5-flash
# Claude only: low | medium | high
REPLICATE_EFFORT=medium
# Gemini only: none | low | high
REPLICATE_THINKING=none
ADMIN_PASSWORD=

# Ads: "placeholder" (default) or "clp". CLP falls back to placeholders until configured.
AD_PROVIDER=placeholder
CLP_API_URL=
CLP_API_KEY=
